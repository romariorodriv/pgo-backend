NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_SHADOW?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN=15m
PORT=3000
GOOGLE_CLIENT_ID="your-android-or-web-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_IDS="android-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com"
FIREBASE_SERVICE_ACCOUNT_PATH="/absolute/path/to/firebase-service-account.json"
FIREBASE_STORAGE_BUCKET="pgo-app-23bbe.firebasestorage.app"
CORS_ORIGINS="https://pgoapp.com,https://www.pgoapp.com"
WEB_REFRESH_COOKIE_NAME=pgo_web_refresh
WEB_COOKIE_DOMAIN=.pgoapp.com

ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=30
ADMIN_COOKIE_NAME=pgo_admin_refresh
ADMIN_COOKIE_DOMAIN=
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_WINDOW_SECONDS=900
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
